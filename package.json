{
  "name": "jarvisbrowser",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/script.ts --outdir dist/ --minify",
    "start:server": "bun run server/server.ts",
    "start": "bun run build && bun run start:server",
    "dev": "bun run --watch server/server.ts",
    "dev:client": "bun --watch build src/script.ts --outdir dist/ --minify"

  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/express": "^5.9.3",
    "@types/ws": "^8.18.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ws": "^8.23.0"
  }
}
