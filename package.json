{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "jarvisbrowser",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/script.ts --outdir dist/ --minify",
    "start:server": "bun run server/server.ts",
    "start": "bun run build && bun run start:server",
    "dev": "bun run --watch server/server.ts",
    "dev:client": "bun build src/script.ts --outdir dist --watch"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "^3.10.1"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@types/argon2": "^0.15.4",
    "@types/express": "^5.0.6",
    "@types/ws": "^8.18.2",
    "express": "^5.3.0",
    "puppeteer": "^25.18.1",
    "ws": "^8.23.0"
  }
}
